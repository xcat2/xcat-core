#!/usr/bin/perl
use strict;
use warnings;

use FindBin;
use File::Basename qw(dirname);
use File::Slurper qw(read_binary write_binary);
use File::Temp qw(tempfile);

my $mode = shift // '';
die "Usage: $0 --check|--write\n"
    unless !@ARGV && ($mode eq '--check' || $mode eq '--write');
my $root = "$FindBin::Bin/..";
my $policy = read_binary("$FindBin::Bin/fips-policy.sh");
die "FIPS policy is empty\n" unless length $policy;
die "FIPS policy must end with a newline\n" unless $policy =~ /\n\z/;
my $begin = "# BEGIN generated FIPS policy: build-utils/sync-fips-policy --write\n";
my $end = "# END generated FIPS policy\n";
my $block = $begin . $policy . $end;
my $failed = 0;

for my $relative ('xCAT-genesis-scripts/usr/lib/xcat/fips.sh',
    'xCAT/postscripts/xcatlib.sh') {
    my $path = "$root/$relative";
    die "$relative must be a regular file\n" unless -f $path && !-l $path;
    my $content = read_binary($path);
    die "$relative must contain one FIPS policy block\n"
        unless (() = $content =~ /\Q$begin\E/g) == 1
            && (() = $content =~ /\Q$end\E/g) == 1;
    my $rendered = $content;
    my $count = $rendered =~ s/\Q$begin\E.*?\Q$end\E/$block/sg;
    die "$relative must contain one FIPS policy block\n" unless $count == 1;
    next if $rendered eq $content;
    if ($mode eq '--check') {
        warn "$relative is out of date; run build-utils/sync-fips-policy --write\n";
        $failed = 1;
        next;
    }
    my ($fh, $temporary) = tempfile('.fips-policy-XXXXXX',
        DIR => dirname($path), UNLINK => 1);
    close $fh or die "close $temporary: $!\n";
    write_binary($temporary, $rendered);
    chmod((stat($path))[2] & oct('0777'), $temporary) or die "chmod $temporary: $!\n";
    rename($temporary, $path) or die "replace $path: $!\n";
}
exit $failed;
