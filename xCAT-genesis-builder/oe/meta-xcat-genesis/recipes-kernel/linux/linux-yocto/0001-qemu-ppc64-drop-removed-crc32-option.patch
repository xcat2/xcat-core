From 8ed74887ba5632c606e99251dc9519874f2e4649 Mon Sep 17 00:00:00 2001
From: xCAT Genesis Builder <xcat@users.noreply.github.com>
Date: Wed, 5 Aug 2026 18:58:00 -0300
Subject: [PATCH] qemu-ppc64: drop removed CRC32 option

CONFIG_CRC32_SLICEBY8 no longer exists in Linux 6.18.

Upstream-Status: Pending
Signed-off-by: xCAT Genesis Builder <xcat@users.noreply.github.com>
---
 bsp/qemu-ppc64/qemu-ppc64.cfg | 1 -
 1 file changed, 1 deletion(-)

diff --git a/bsp/qemu-ppc64/qemu-ppc64.cfg b/bsp/qemu-ppc64/qemu-ppc64.cfg
index 4179518..387d27f 100644
--- a/bsp/qemu-ppc64/qemu-ppc64.cfg
+++ b/bsp/qemu-ppc64/qemu-ppc64.cfg
@@ -32,6 +32,5 @@ CONFIG_FB_OF=y
 CONFIG_DUMMY_CONSOLE=y
 CONFIG_FRAMEBUFFER_CONSOLE=y
-CONFIG_CRC32_SLICEBY8=y
 CONFIG_ZLIB_INFLATE=y
 CONFIG_GENERIC_ALLOCATOR=y
 CONFIG_TEXTSEARCH=y
