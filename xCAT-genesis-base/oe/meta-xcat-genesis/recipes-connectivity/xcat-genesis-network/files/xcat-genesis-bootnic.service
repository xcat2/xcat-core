[Unit]
Description=Keep the xCAT Genesis DHCPv6 reservation on the boot nic
ConditionKernelCommandLine=xcatd
After=systemd-udev-trigger.service
Before=NetworkManager.service xcat-genesis-network-state.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/xcat/genesis-bootnic
TimeoutStartSec=30
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
