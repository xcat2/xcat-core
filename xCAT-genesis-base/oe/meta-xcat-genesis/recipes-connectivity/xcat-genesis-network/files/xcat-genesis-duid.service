[Unit]
Description=Write the xCAT Genesis DHCPv6 client identifier
ConditionKernelCommandLine=xcatd
After=systemd-udev-trigger.service
Before=NetworkManager.service xcat-genesis-network-state.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/xcat/genesis-duid
TimeoutStartSec=30
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
