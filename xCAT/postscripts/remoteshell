if [ "$USEFLOWCONTROL" = "YES" ] || [ "$USEFLOWCONTROL" = "yes" ] || [ "$USEFLOWCONTROL" = "1" ]; then
  useflowcontrol=1
fi

# Write a drop-in fragment atomically: scratch file then rename, the leading dot
# keeping the scratch out of sshd's *.conf glob.  Returns nonzero without
# touching anything if the write fails or the file is not ours, so the caller
# can fall back.
XCATSSHDDROPINMARKER="# Written by the xCAT remoteshell postscript."
xcat_write_dropin() {
    xcat_dir=$1
    xcat_file=$2
    shift 2
    xcat_dest="$xcat_dir/$xcat_file"
    # Never overwrite a file without our marker on the first line.
    if [ -e "$xcat_dest" ] && \
        ! head -n 1 "$xcat_dest" 2>/dev/null | grep -qF "$XCATSSHDDROPINMARKER"; then
        return 1
    fi
    xcat_tmp="$xcat_dir/.$xcat_file.xcatnew.$$"
    mkdir -p "$xcat_dir" 2>/dev/null || return 1
    : >"$xcat_tmp" 2>/dev/null || return 1
    chmod 600 "$xcat_tmp" 2>/dev/null
    {
        echo "$XCATSSHDDROPINMARKER  Do not edit."
        for xcat_line in "$@"; do
            echo "$xcat_line"
        done
    } >>"$xcat_tmp" 2>/dev/null || { rm -f "$xcat_tmp"; return 1; }
    mv -f "$xcat_tmp" "$xcat_dest" 2>/dev/null || { rm -f "$xcat_tmp"; return 1; }
    return 0
}

# sshd keeps the first value it finds for a keyword, so a setting ahead of the
# Include line or in an earlier fragment still wins over ours; log it.
xcat_warn_if_overridden() {
    xcat_kw=$1
    xcat_own="$XCATSSHDDROPINDIR/$2"
    if sed -n '/^[[:space:]]*[Ii][Nn][Cc][Ll][Uu][Dd][Ee][[:space:]]/q; p' /etc/ssh/sshd_config 2>/dev/null | \
        grep -i "^[[:space:]]*${xcat_kw}[[:space:]]" >/dev/null 2>&1; then
        logger -t $log_label -p local4.warning "remoteshell: $xcat_kw is set before the Include line in /etc/ssh/sshd_config and overrides $xcat_own"
    fi
    for xcat_frag in "$XCATSSHDDROPINDIR"/*.conf; do
        [ "$xcat_frag" = "$xcat_own" ] && break
        [ -r "$xcat_frag" ] || continue
        if grep -i "^[[:space:]]*${xcat_kw}[[:space:]]" "$xcat_frag" >/dev/null 2>&1; then
            logger -t $log_label -p local4.warning "remoteshell: $xcat_frag sets $xcat_kw and is read before $xcat_own"
        fi
    done
}

if [ -r /etc/ssh/sshd_config ]
then
	logger -t $log_label -p local4.info "remoteshell:  setup /etc/ssh/sshd_config and ssh_config"

    # Where sshd supports Include (OpenSSH 8.2+), write to a drop-in and leave
    # sshd_config alone; older sshd is edited in place.  Take the directory only
    # from an Include ahead of the first Match block, since one inside Match does
    # not apply to every connection.
    XCATSSHDDIR=`sed -n '/^[[:space:]]*[Mm][Aa][Tt][Cc][Hh][[:space:]]/q; s|^[[:space:]]*[Ii][Nn][Cc][Ll][Uu][Dd][Ee][[:space:]]\{1,\}\([^[:space:]]\{1,\}\)/\*\.conf[[:space:]]*$|\1|p' /etc/ssh/sshd_config | head -n 1`
    # sshd resolves a relative Include under /etc/ssh, not the working directory.
    case "$XCATSSHDDIR" in
        ""|/*) ;;
        *)     XCATSSHDDIR="/etc/ssh/$XCATSSHDDIR" ;;
    esac
    # A parent that is itself a glob (sshd_config.[12].d) is a pattern, not a
    # directory, so leave it to the in-place edit.
    case "$XCATSSHDDIR" in
        *[][*?]*) XCATSSHDDIR="" ;;
    esac
    XCATSSHDDROPINDIR=""
    if [ -n "$XCATSSHDDIR" ]; then
        if xcat_write_dropin "$XCATSSHDDIR" "01-xcat.conf" "X11Forwarding yes"; then
            XCATSSHDDROPINDIR="$XCATSSHDDIR"
            xcat_warn_if_overridden "X11Forwarding" "01-xcat.conf"
        else
            logger -t $log_label -p local4.err "remoteshell: could not write $XCATSSHDDIR/01-xcat.conf, editing /etc/ssh/sshd_config instead"
        fi
    fi
    if [ -z "$XCATSSHDDROPINDIR" ]; then
        cp /etc/ssh/sshd_config /etc/ssh/sshd_config.ORIG
        #delete all occurance of the attribute and then add xCAT settings
        sed -i '/X11Forwarding /'d /etc/ssh/sshd_config
        echo "X11Forwarding yes" >>/etc/ssh/sshd_config
    fi

    # PCM settings go in their own fragment: they are only set with -p, and
    # updatenode reruns remoteshell without it, so a shared file would drop them
    # on the next run.  If the fragment cannot be written, edit sshd_config in
    # place rather than leaving PCM unset.
    if [ "$SETUPFORPCM" = "1" ]; then
        if [[ $OSVER == sle* ]];then
            if [ -n "$XCATSSHDDROPINDIR" ] && \
                xcat_write_dropin "$XCATSSHDDROPINDIR" "02-xcat-pcm.conf" "PasswordAuthentication yes"; then
                xcat_warn_if_overridden "PasswordAuthentication" "02-xcat-pcm.conf"
            else
                [ -e /etc/ssh/sshd_config.ORIG ] || cp /etc/ssh/sshd_config /etc/ssh/sshd_config.ORIG
                sed -i '/PasswordAuthentication /'d /etc/ssh/sshd_config
                echo "PasswordAuthentication yes" >>/etc/ssh/sshd_config
            fi
        elif [[ $OSVER == ubuntu* ]];then
            if [ -n "$XCATSSHDDROPINDIR" ] && \
                xcat_write_dropin "$XCATSSHDDROPINDIR" "02-xcat-pcm.conf" "PermitRootLogin yes"; then
                xcat_warn_if_overridden "PermitRootLogin" "02-xcat-pcm.conf"
            else
                [ -e /etc/ssh/sshd_config.ORIG ] || cp /etc/ssh/sshd_config /etc/ssh/sshd_config.ORIG
                sed -i 's/^PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config
            fi
        fi
    fi
fi

if [ -r /etc/ssh/ssh_config ]
then
   sed -i '/StrictHostKeyChecking /'d /etc/ssh/ssh_config
   echo "StrictHostKeyChecking no" >> /etc/ssh/ssh_config

fi
xcatpost="xcatpost"
if [ -d /xcatpost/_ssh ]
then
	logger -p local4.info -t $log_label "Install: setup root .ssh"
	cd /xcatpost/_ssh
	mkdir -p /root/.ssh
	cp -f * /root/.ssh
   cd - >/dev/null
	chmod 700 /root/.ssh
	chmod 600 /root/.ssh/*
fi

if [ ! -x /usr/bin/openssl ]; then
    logger -t $log_label -p local4.err "Install: /usr/bin/openssl is not executable."
    exit 0
fi
allowcred.awk &
CREDPID=$!
sleep 1

#download the ssh host dsa private keys
if [ $useflowcontrol = "1" ]; then
  #first contact daemon  xcatflowrequest <server> 3001
  logger -t $log_label -p local4.info "remoteshell: sending xcatflowrequest $master 3001"
 /$xcatpost/xcatflowrequest $master 3001
 rc=$?
 logger -t $log_label -p local4.info "remoteshell:xcatflowrequest received response return=$rc"
 if [ $rc -ne 0 ]; then
      logger -t $log_label -p local4.info "remoteshell: error from xcatflowrequest, will not use flow control"
      useflowcontrol=0
 fi


fi
getcredentials.awk ssh_dsa_hostkey | grep -E -v '</{0,1}xcatresponse>|</{0,1}serverdone>' | sed -e 's/&lt;/</' -e 's/&gt;/>/' -e 's/&amp;/&/' -e 's/&quot/"/' -e "s/&apos;/'/" > /tmp/ssh_dsa_hostkey

#check the message is an error or not
grep -E '<error>' /tmp/ssh_dsa_hostkey > /dev/null 2>&1
if [ $? -ne 0 ]; then
	#the message received is the data
	cat /tmp/ssh_dsa_hostkey | grep -E -v '</{0,1}errorcode>|/{0,1}data>|</{0,1}content>|</{0,1}desc>' >/etc/ssh/ssh_host_dsa_key
	logger -t $log_label -p local4.info "remoteshell: getting ssh_host_dsa_key"
   MAX_RETRIES=10
   RETRY=0
   MYCONT=`cat /etc/ssh/ssh_host_dsa_key`
   while [ -z "$MYCONT" ]; do
              # not using flow control , need to sleep
              if [ $useflowcontrol = "0" ]; then
                let SLI=$RANDOM%10
                let SLI=SLI+10
                sleep $SLI
              fi

                RETRY=$(($RETRY+1))
