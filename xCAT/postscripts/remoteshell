if [ "$?" != "0" ];then
   PIDLIST=`ps aux | grep -v grep | grep "/usr/sbin/sshd"|awk -F" " '{print $2}'|xargs`
   [ -n "$PIDLIST" ] && kill 9 $PIDLIST
   /usr/sbin/sshd
