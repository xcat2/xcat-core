#  Linux or if AIX call aixremoteshell -d
if [ "$(uname -s)" = "AIX" ]; then
   ./aixremoteshell -d 2>&1
	logger -t $log_label -p local4.info "Install: On AIX , remoteshell calling aixremoteshell -d "
