# kdump.service fails without dump memory, which the kernel has only when its
# command line carries crashkernel= or, on POWER, fadump=.
if [ -e /usr/lib/systemd/system/kdump.service ]; then
    mkdir -p /etc/systemd/system/kdump.service.d
    printf '[Unit]\nConditionKernelCommandLine=|crashkernel\nConditionKernelCommandLine=|fadump\n' \
        >/etc/systemd/system/kdump.service.d/xcat-dump-memory.conf
fi
