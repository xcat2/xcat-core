# kdump.service fails without dump memory, which the kernel has only when its
# command line carries crashkernel= or, on POWER, fadump=.
if [ -e /usr/lib/systemd/system/kdump.service ]; then
    xcat_kdump_policy=$(cat <<'XCAT_DUMP_MEMORY'
#INCLUDE:#ENV:XCATROOT#/share/xcat/netboot/imgutils/xcat-dump-memory.conf#
XCAT_DUMP_MEMORY
        # Keep the asset's trailing newlines through command substitution.
        printf '.'
    )
    case "$xcat_kdump_policy" in
        '#INCLUDEBAD:'*) printf '%s\n' "${xcat_kdump_policy%.}" >&2; exit 1 ;;
    esac
    mkdir -p /etc/systemd/system/kdump.service.d
    printf '%s' "${xcat_kdump_policy%.}" >/etc/systemd/system/kdump.service.d/xcat-dump-memory.conf
fi
