#!/bin/sh
echo $drivers
dracut_install wget tar cpio gzip dash modprobe touch echo cut wc xz sha256sum
dracut_install grep hostname awk egrep dirname expr ip sed tr cat
dracut_install mount.nfs
inst "$moddir/xcatroot" "/sbin/xcatroot"
inst_hook cmdline 10 "$moddir/xcat-cmdline.sh"
[ -r "$moddir/xcat-rootimg-checksum.sh" ] || { echo "Cannot read $moddir/xcat-rootimg-checksum.sh" >&2; exit 1; }
inst "$moddir/xcat-rootimg-checksum.sh" "/lib/xcat-rootimg-checksum.sh" || exit 1

. "$moddir/xcat-rootimg-install.sh" || exit 1
xcat_install_uftp_receiver inst
# install netroot dispatcher if available (dracut 051+ with network-legacy)
if [ -f "$moddir/../40network/netroot.sh" ]; then
    inst "$moddir/../40network/netroot.sh" "/sbin/netroot"
fi
# Only network-legacy's ifup calls that dispatcher, and Ubuntu 25.10 and later ship no
# network-legacy, so on 26.04 nothing reaches /sbin/xcatroot. Call it from the online hook,
# which systemd-networkd and NetworkManager both reach.
inst_hook initqueue/online 90 "$moddir/xcat-online.sh"
inst_simple "$moddir/xcat-bootif-dhcp.conf" /etc/systemd/network/70-BOOTIF.network.d/xcat-bootif-dhcp.conf
