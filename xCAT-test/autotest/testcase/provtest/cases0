# provtest issues the requests a node issues while it provisions -- dig for
# DNS, tftp for TFTP, curl for HTTP, and a small client of its own for the
# xcatd protocols -- and asserts on the answers. Like dhcptest it is
# implementation-agnostic: it never reads the xCAT database and never runs an
# xCAT command to decide what to expect. Everything it is told about the
# cluster arrives on the command line from provfixture.sh, which is where all
# the xCAT knowledge lives.
#
# The first two cases are offline -- no network, no root -- and are safe
# anywhere.
#
# The wire cases build their own provisioning network out of a veth pair, via
# provfixture.sh: a network object, four nodes covering the four netboot
# methods, an osimage over a fabricated install tree, DNS, and whatever nodeset
# writes from all of that. The client end of the veth lives in a network
# namespace of its own, because xcatd calls a discovering machine back on TCP
# 3001 -- the port it is itself listening on -- and a client sharing the
# management node's stack could never hold it. That is what makes these cases
# mean something on a single-node management node, the CI runner above all,
# instead of quietly passing with nothing to talk to.
#
# Each wire case is one script rather than a series of commands, so its
# teardown runs from a trap and the machine is left serving its own
# configuration even when an assertion fails half way through.
#
# A case that cannot run says so and passes: no root, no veth support, a
# namespace or an interface of that name already present, the fixture's
# network already managed. Read a pass as real coverage only when the log
# shows the ok lines.

start:provtest_unit_tests
description:provtest's own unit tests: no network and no root needed
label:mn_only,ci_test,prov
os:Linux
cmd:cd /opt/xcat/share/xcat/tools/autotest/provtest/tests && python3 -m unittest discover -s . -p 'test_*.py'
check:rc==0
end

start:provtest_validate_conf
description:Every shipped provtest scenario parses and every assertion names a field its step can carry
label:mn_only,ci_test,prov
os:Linux
cmd:cd /opt/xcat/share/xcat/tools/autotest/provtest && python3 src/provtest validate conf/*.conf
check:rc==0
check:output=~scenario
end

start:provtest_name_resolution
description:Every name a node resolves during provisioning answers, in both directions
label:mn_only,prov,prov_wire
os:Linux
# Every case below carries prov_wire and, deliberately, not ci_test.
#
# The wire cases do not leave the machine alone while they run: they add a veth
# pair and a namespace, define a network and nodes, set site.master,
# site.domain and possibly site.httpport, rewrite the zone, and run nodeset and
# mknb. Each one puts all of that back from a trap, but a ci_test case running
# in between would be sharing a management node that is mid-reconfiguration. So
# the CI driver runs the whole ci_test set first, and only then runs this set
# -- see run_prov_wire_test in github_action_xcat_test.pl.
#
# This first case is the one the rest depend on: a node that cannot resolve its
# own name does not reach any of the servers the later cases ask about, and
# xcatd identifies a client by the reverse lookup of the address its connection
# arrived from, so the PTR is not a convenience but the authentication model.
cmd:#!/bin/bash
    set -u
    FIX=/opt/xcat/share/xcat/tools/autotest/testcase/provtest/provfixture.sh
    "$FIX" check || exit 0
    trap '"$FIX" teardown' EXIT
    "$FIX" setup || exit 1
    "$FIX" run-dns || exit 1
check:rc==0
end

start:provtest_loader_and_config_fetch
description:Each netboot method's loader, config and kernel are fetchable under the names the firmware asks for
label:mn_only,prov,prov_wire
os:Linux
# Four netboot methods, four naming schemes, one question: the firmware asks
# for an exact name, and a name that is wrong by one hex digit produces no
# error anywhere -- just a machine that sits at the loader until somebody
# reboots it. Each method is given its own node, because a node has one
# netboot method and running all four sets against one of them would always
# fail three.
#
# The cross-stage steps are the point: the config is fetched, the kernel path
# is read out of whatever came back, and that path is fetched. Nothing in the
# scenarios says what the kernel will be called, which is what stops them
# asserting xCAT's output against a copy of xCAT's output.
cmd:#!/bin/bash
    set -u
    FIX=/opt/xcat/share/xcat/tools/autotest/testcase/provtest/provfixture.sh
    "$FIX" check || exit 0
    trap '"$FIX" teardown' EXIT
    "$FIX" setup || exit 1
    "$FIX" run-tftp || exit 1
check:rc==0
end

start:provtest_install_tree_over_http
description:The repository, the kickstart and the port the node was told about all answer
label:mn_only,prov,prov_wire
os:Linux
# After the loader, everything the installer needs arrives over HTTP, on
# whichever port site.httpport names -- and that port is written into the
# node's kernel command line at nodeset time, so a web server moved afterwards
# leaves every already-configured node fetching from a port nothing listens on.
# The fixture moves the port on purpose and the scenarios assert against the
# port the node was told about rather than the one the management node happens
# to be serving now.
cmd:#!/bin/bash
    set -u
    FIX=/opt/xcat/share/xcat/tools/autotest/testcase/provtest/provfixture.sh
    "$FIX" check || exit 0
    trap '"$FIX" teardown' EXIT
    "$FIX" setup || exit 1
    "$FIX" run-http || exit 1
check:rc==0
end

