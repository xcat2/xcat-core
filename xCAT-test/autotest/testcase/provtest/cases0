start:provtest_discovery_requests
description:Flow control and findme, including the requests xcatd must acknowledge and then ignore
label:mn_only,prov,prov_wire
os:Linux
# xcatd acknowledges a findme before it checks where it came from, and drops it
# afterwards if the source port is unprivileged or the address is on no network
# it is attached to. So an ignored findme and an accepted one look identical
# for the first callback and differ only in whether a second arrives -- which
# is why these scenarios assert on the number of callbacks rather than on their
# presence, and why the fixture reaches the foreign address through a gateway
# instead of putting it on the wire.
cmd:#!/bin/bash
    set -u
    FIX=/opt/xcat/share/xcat/tools/autotest/testcase/provtest/provfixture.sh
    "$FIX" check || exit 0
    trap '"$FIX" teardown' EXIT
    "$FIX" setup || exit 1
    "$FIX" run-discovery || exit 1
check:rc==0
end

start:provtest_xcatd_protocol
description:getdestiny, getpostscript and getcredentials, from the address that is the identity
label:mn_only,prov,prov_wire
os:Linux
# The requests genesis and the installing node make over TLS 3001, issued the
# way they issue them: no client certificate, and the source address as the
# whole of the authentication. The known and unknown scenarios differ in
# exactly one thing -- which address the request left by.
#
# getcredentials is asserted in both directions, because the callback xcatd
# makes to the client's port 300 is the only thing standing between "an address
# with a PTR" and "a signed cluster certificate".
cmd:#!/bin/bash
    set -u
    FIX=/opt/xcat/share/xcat/tools/autotest/testcase/provtest/provfixture.sh
    "$FIX" check || exit 0
    trap '"$FIX" teardown' EXIT
    "$FIX" setup || exit 1
    "$FIX" run-xcatd || exit 1
check:rc==0
end

