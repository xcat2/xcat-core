start:dhcptest_provision_vs_discovery
description:A defined node gets its reservation and an unknown one gets a pool address
label:mn_only,ci_test,dhcp
os:Linux
cmd:#!/bin/bash
    set -u
    FIX=/opt/xcat/share/xcat/tools/autotest/testcase/dhcptest/dhcpfixture.sh
    "$FIX" check || exit 0
    trap '"$FIX" teardown' EXIT
    "$FIX" setup || exit 1
    "$FIX" run || exit 1
check:rc==0
end

start:dhcptest_backend_switch
description:The same wire expectations hold after switching to the other DHCP backend
label:mn_only,ci_test,dhcp
os:Linux
cmd:#!/bin/bash
    set -u
    FIX=/opt/xcat/share/xcat/tools/autotest/testcase/dhcptest/dhcpfixture.sh
    "$FIX" check || exit 0
    ALT=$("$FIX" alt-backend)
    if [ -z "$ALT" ]; then echo "dhcptest skipped: only one DHCP backend is installed"; exit 0; fi
    trap '"$FIX" teardown' EXIT
    "$FIX" setup || exit 1
    echo "== serving with the configured backend =="
    "$FIX" run || exit 1
    echo "== switching to $ALT =="
    "$FIX" backend "$ALT" || exit 1
    "$FIX" run || exit 1
check:rc==0
end

