start:dhcptest_provision_vs_discovery
description:A defined node gets its reservation and an unknown one gets a pool address
label:mn_only,dhcp,dhcp_wire
os:Linux
# Every case below carries dhcp_wire and, deliberately, not ci_test.
#
# The wire cases are not part of the ci_test set because they do not leave the
# machine alone while they run: they add a veth pair, point site.dhcpinterfaces
# at it, switch site.dhcpbackend, and stop and start the DHCP daemon. Each one
# puts all of that back from a trap, but a ci_test case running in between would
# be sharing a management node that is mid-reconfiguration. So the CI driver
# runs the whole ci_test set first, and only then runs this set -- see
# run_dhcp_wire_test in github_action_xcat_test.pl.
#
# Keeping them out of ci_test is also what stops them being run twice. The set
# is run once per DHCP backend installed: against ISC, then against Kea, each
# pass bracketed by `dhcpfixture.sh backend-setup` and `backend-teardown`. Which
# backend a cluster runs is decided by the management node's distro, not by the
# operator, so a scenario that holds on one backend and not the other is a node
# that boots on RHEL 9 and hangs on RHEL 10.
#
# The backend is therefore not chosen in here. Each case serves whatever
# site.dhcpbackend the surrounding pass selected, and reports under the backend
# name the driver printed, so a failure says which backend it belonged to.
cmd:#!/bin/bash
    set -u
    FIX=/opt/xcat/share/xcat/tools/autotest/testcase/dhcptest/dhcpfixture.sh
    "$FIX" check || exit 0
    trap '"$FIX" teardown' EXIT
    "$FIX" setup || exit 1
    "$FIX" run || exit 1
check:rc==0
end

start:dhcptest_boot_architectures
description:Each client architecture is handed the loader that belongs to it
label:mn_only,dhcp,dhcp_wire
os:Linux
# Option 93 is where xCAT's DHCP behaviour branches most, and where a mistake
# is most expensive: a machine handed the wrong loader either hangs at the
# firmware or boots the wrong thing entirely. Every architecture is asserted
# under every backend, against the same expected loader for both: the backends
# have to agree, and the fixture puts the loaders they key on in place first so
# that they are answering the same question.
cmd:#!/bin/bash
    set -u
    FIX=/opt/xcat/share/xcat/tools/autotest/testcase/dhcptest/dhcpfixture.sh
    "$FIX" check || exit 0
    trap '"$FIX" teardown' EXIT
    "$FIX" setup || exit 1
    "$FIX" run-arch || exit 1
check:rc==0
end

start:dhcptest_netboot_methods
description:A node is handed the loader its netboot method names, whatever its architecture says
label:mn_only,dhcp,dhcp_wire
os:Linux
# The other direction from the architecture case. There, nobody has defined the
# machine and the answer has to come from the subnet; here the operator has
# said how this particular node boots, and the answer has to come from that.
# A backend that leans on a subnet-wide boot class answers a nimol or a yaboot
# node with an x86 loader, and the machine does not install.
#
# The *NOIP* port is asserted in the same case because it is the same question
# asked backwards: a marking on one node's NIC has to beat whatever the subnet
# would otherwise have said.
cmd:#!/bin/bash
    set -u
    FIX=/opt/xcat/share/xcat/tools/autotest/testcase/dhcptest/dhcpfixture.sh
    "$FIX" check || exit 0
    trap '"$FIX" teardown' EXIT
    "$FIX" setup || exit 1
    "$FIX" run-netboot || exit 1
check:rc==0
end

start:dhcptest_node_identity
description:Which node an address, a name and a next-server belong to
label:mn_only,dhcp,dhcp_wire
os:Linux
# Three questions that all come down to the server keeping one node's answer
# apart from another's: a node with two provisioning ports has to be reachable
# on either of them and come up under the right name on each; a node's
# next-server has to follow its own attributes rather than the subnet's, which
# is invisible in a flat cluster and decides whether a machine boots at all in
# a hierarchical one; and a node whose reservation was withdrawn has to stop
# being handed the address somebody else now owns.
cmd:#!/bin/bash
    set -u
    FIX=/opt/xcat/share/xcat/tools/autotest/testcase/dhcptest/dhcpfixture.sh
    "$FIX" check || exit 0
    trap '"$FIX" teardown' EXIT
    "$FIX" setup || exit 1
    rc=0
    "$FIX" run-nextserver || rc=1
    "$FIX" run-multimac || rc=1
    "$FIX" run-removal || rc=1
    exit $rc
check:rc==0
end

start:dhcptest_boot_file_conditions
description:A loader is named only when it is fetchable, when it is wanted, and its URL names the right port
label:mn_only,dhcp,dhcp_wire
os:Linux
# The first two change what the management node looks like before the
# configuration is generated -- one takes a loader off disk, the other moves
# the web server's port -- because both backends decide what to write by
# reading those. Each puts the machine back and regenerates before returning,
# so the cases that follow are not run against a cluster half way through an
# experiment.
#
# The third asks the opposite question: a node that has an operating system
# already must not be named a netboot script, however fetchable that script
# is, or it reinstalls itself on every power cycle.
cmd:#!/bin/bash
    set -u
    FIX=/opt/xcat/share/xcat/tools/autotest/testcase/dhcptest/dhcpfixture.sh
    "$FIX" check || exit 0
    trap '"$FIX" teardown' EXIT
    "$FIX" setup || exit 1
    rc=0
    "$FIX" run-loader-absent || rc=1
    "$FIX" run-httpport || rc=1
    "$FIX" run-localboot || rc=1
    exit $rc
check:rc==0
end

start:dhcptest_legacy_and_storage_clients
