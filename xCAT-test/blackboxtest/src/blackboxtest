#!/usr/bin/env python3
"""blackboxtest -- ask a management node what a booting node asks, and check
the answers.

Runs straight out of a checkout: this script puts its own directory on
sys.path, so no installation, no virtualenv and no pip are involved.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from blackboxtest_lib.cli import main          # noqa: E402  (path set up above)

if __name__ == "__main__":
    sys.exit(main())
